# Copy to backend/.env and fill in the channels you want. Empty = channel off.
# The backend never fails a request because a channel is missing.

# Google Sheets + Gmail — one Apps Script web app does both (see appsscript.gs).
# Deploy: script.google.com → new project → paste appsscript.gs →
#   Deploy → New deployment → Web app → Execute as: Me, Access: Anyone →
#   copy the /exec URL here.
SHEETS_WEBAPP_URL=

# Notion — integration token (notion.so/my-integrations) + the database ID
# created via the Notion MCP or manually. Share the database with the
# integration (… → Connect to → your integration) or the API returns 404.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Generic webhook — Slack incoming webhook, Discord channel webhook,
# Make/Zapier webhook, Telegram bot sendMessage URL… any JSON webhook.
WEBHOOK_URL=

# CORS — dev + deployed origins.
ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173

# Port for `python main.py`.
PORT=8425
